.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.jks

# ── 로컬 데이터 ────────────────────────────────────
# MariaDB 로 옮기기 전 쓰던 H2 파일. 실행하면 다시 생긴다.
docker-data/
*.mv.db
*.trace.db
*.bak

# ── 테스트 산출물 ──────────────────────────────────
test-results/
playwright-report/
blob-report/
playwright/.cache/
coverage/

# ── 에디터·OS ──────────────────────────────────────
.idea/
*.iml
.vscode/
.DS_Store
Thumbs.db

# ── 로그 ───────────────────────────────────────────
*.log
logs/
